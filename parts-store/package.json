{
  "name": "jme-parts-store",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "description": "JM Equipment Parts Store \u2014 production-candidate sandbox (industrial B2B parts storefront)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "agent:maintenance": "tsx scripts/run-agent.ts maintenance",
    "agent:security": "tsx scripts/run-agent.ts security",
    "agent:triage": "tsx scripts/run-agent.ts triage",
    "retention": "tsx scripts/retention.ts",
    "dev:demo": "QC_DEMO_SEED=1 next dev",
    "verify:bundles": "tsx scripts/verifyBundles.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.1",
    "minimatch@^3": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@>=10": {
      "brace-expansion": "^5.0.9"
    }
  }
}
