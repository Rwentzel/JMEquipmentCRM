# dependencies
node_modules/
# build artifacts
dist/
*.exe
# OS / editor files
.vscode/
.DS_Store
Thumbs.db
# Git metadata (if you ever nested repos)
.git/

# runtime data (RFQ store, Quote Center, audit log) — contains customer PII,
# never commit. The wildcard also catches the throwaway dirs that testing and
# debugging produce (.data-ops, .data-perf, ...); one of those was staged once,
# and an ignore rule is cheaper than remembering every time.
parts-store/.data*/
.data*/
# next build output
parts-store/.next/
*.tsbuildinfo

# Operational backups of .data/ — contain customer PII and quote pricing.
# Store these encrypted and off-box; never commit one.
.backups/
